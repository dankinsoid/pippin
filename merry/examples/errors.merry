;; Each form below is rejected; the comments the checker prints say why.

(defn read-config [path]
  (slurp path))

(defn startup [path]
  (println "loading" path)
  (read-config path))

(defn -main {:eff #{Console}} []
  (startup "app.edn"))

(defn nested-placeholder [xs]
  (-> xs (map (fn [x] (+ x $)))))

(defn mixed-chain [x]
  (<= 0 x "10"))

(defn not-a-bool [xs]
  (if (first xs) 1 0))

(defn missing-field []
  (:total {:id 1}))

(defn old-default [x]
  (cond (pos? x) 1 :else 0))

(defn label [s]
  (match s
    [:paid amount] amount
    [:refund]      0))

(defn unhandled-variant []
  (label [:void]))

(defn flows-in [c]
  (let [s (if c [:paid 1] [:void])]
    (match s
      [:paid n] n)))

(defn not-covered [s]
  (match s
    [:paid 0] :free
    [:refund] :back))

(defn wrong-shape [s]
  (match s
    [:paid n]   n
    [:paid n m] m))

(defn bare-name-first [s]
  (match s
    x         x
    [:paid n] n))
